# Ask Noor: environment variable NAMES only (TRD section 12).
# Copy each group into the file named in its heading, fill in values there, and never commit
# values. Real .env files are gitignored.

# --- Client: apps/web/.env ---
# Vite exposes only VITE_* names to the browser. Use the anon key only.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_FARM_ID=
VITE_PACK_BASE_URL=
VITE_DEMO_MODE=

# --- Server only: Supabase Edge Function secrets, never in apps/web ---
# Never prefix these with VITE_: that would put them in the browser bundle.
SUPABASE_SERVICE_ROLE_KEY=
GROQ_API_KEY=
GROQ_MODEL=
SMS_MODE=
# SMS provider key names are added with the provider chosen for the cooperative texts.

# --- Pipeline only: pipeline/.env (build time, never at guest runtime) ---
ELEVENLABS_API_KEY=
HF_HOME=
