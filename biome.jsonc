{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "apps/**",
      "packages/**",
      "content/**/*.ts",
      "*.json",
      "*.jsonc",
      "*.ts",
      "!!**/dist",
      "!!**/coverage",
      "!!**/playwright-report",
      "!!**/test-results",
      "!!.claude",
      "!!.github",
      "!!.githooks",
      "!!docs",
      "!!tasks",
      // Generated by `bun run --cwd packages/core export:schema`; the drift test guards it.
      "!!packages/core/schema"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": { "preset": "recommended" },
    "domains": { "react": "recommended" }
  },
  "assist": {
    "enabled": true,
    "actions": { "source": { "organizeImports": "on" } }
  },
  "css": { "parser": { "tailwindDirectives": true } },
  // The files below are generated by `shadcn add` (Animate UI). We fixed what broke our strict
  // TypeScript flags, but not their style. Each entry turns off only the one rule that fires in
  // that one file, so new code is still linted in full.
  "overrides": [
    {
      "includes": ["apps/web/src/components/animate-ui/primitives/animate/slot.tsx"],
      "linter": { "rules": { "suspicious": { "noExplicitAny": "off" } } }
    },
    {
      "includes": ["apps/web/src/components/animate-ui/primitives/effects/highlight.tsx"],
      "linter": { "rules": { "suspicious": { "noExplicitAny": "off", "noArrayIndexKey": "off" } } }
    },
    {
      "includes": ["apps/web/src/hooks/use-controlled-state.tsx"],
      "linter": { "rules": { "suspicious": { "noExplicitAny": "off" } } }
    },
    {
      "includes": ["apps/web/src/hooks/use-auto-height.tsx"],
      "linter": { "rules": { "correctness": { "useExhaustiveDependencies": "off" } } }
    }
  ]
}
