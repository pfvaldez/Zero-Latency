{
  "name": "ask-noor",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.10",
  "engines": {
    "node": "24.x"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/web dev",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "bun run --cwd apps/web e2e",
    "check": "biome check .",
    "typecheck": "tsc -b",
    "pack:model": "bun run --cwd packages/pack model",
    "pack:build": "bun run --cwd packages/pack build",
    "pack:fixture": "bun run --cwd packages/pack fixture",
    "eval": "bun run --cwd packages/pack eval",
    "test:model": "vitest run --config packages/pack/vitest.model.config.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@vitest/coverage-v8": "4.1.11",
    "jsdom": "29.1.1",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
