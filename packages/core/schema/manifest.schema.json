{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "packId": {
      "type": "string",
      "minLength": 1
    },
    "farmId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "farmSlug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "version": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "mode": {
      "type": "string",
      "enum": [
        "production",
        "demo"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "noorLang": {
      "type": "string",
      "enum": [
        "wo",
        "gu"
      ]
    },
    "visitorLangs": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "en",
          "de",
          "nl",
          "sv"
        ]
      }
    },
    "clips": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "kind": {
            "type": "string",
            "enum": [
              "stop",
              "answer"
            ]
          },
          "stopCode": {
            "type": "string",
            "minLength": 1
          },
          "audio": {
            "type": "string",
            "minLength": 1
          },
          "durationMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "momentIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "subtitles": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "enum": [
                "en",
                "de",
                "nl",
                "sv"
              ]
            },
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          },
          "dubbed": {
            "type": "object",
            "properties": {
              "lang": {
                "type": "string",
                "const": "wo"
              },
              "audio": {
                "type": "string",
                "minLength": 1
              },
              "durationMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "subtitles": {
                "type": "string",
                "minLength": 1
              },
              "subtitlesDraft": {
                "type": "boolean",
                "const": true
              },
              "label": {
                "type": "string",
                "const": "AI-dubbed (ElevenLabs)"
              }
            },
            "required": [
              "lang",
              "audio",
              "durationMs",
              "label"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "kind",
          "audio",
          "durationMs",
          "momentIds",
          "subtitles"
        ],
        "additionalProperties": false
      }
    },
    "moments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "clipId": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "startMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "endMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "subtitles": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "enum": [
                "en",
                "de",
                "nl",
                "sv"
              ]
            },
            "additionalProperties": {
              "type": "string"
            }
          },
          "topic": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "enum": [
                "en",
                "de",
                "nl",
                "sv"
              ]
            },
            "additionalProperties": {
              "type": "string"
            }
          },
          "draft": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "enum": [
                "en",
                "de",
                "nl",
                "sv"
              ]
            },
            "additionalProperties": {
              "type": "boolean"
            }
          },
          "timing": {
            "type": "string",
            "enum": [
              "estimated",
              "word-timestamps"
            ]
          }
        },
        "required": [
          "id",
          "clipId",
          "startMs",
          "endMs",
          "subtitles",
          "topic",
          "timing"
        ],
        "additionalProperties": false
      }
    },
    "addons": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "enum": [
                    "en",
                    "de",
                    "nl",
                    "sv"
                  ]
                },
                "additionalProperties": {
                  "type": "string"
                }
              },
              "checked": {
                "type": "boolean"
              },
              "needs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "source",
                    "price",
                    "phone"
                  ]
                }
              },
              "kind": {
                "type": "string",
                "const": "fact"
              },
              "source": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "text",
              "checked",
              "kind"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "enum": [
                    "en",
                    "de",
                    "nl",
                    "sv"
                  ]
                },
                "additionalProperties": {
                  "type": "string"
                }
              },
              "checked": {
                "type": "boolean"
              },
              "needs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "source",
                    "price",
                    "phone"
                  ]
                }
              },
              "kind": {
                "type": "string",
                "const": "recipe"
              }
            },
            "required": [
              "id",
              "text",
              "checked",
              "kind"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "enum": [
                    "en",
                    "de",
                    "nl",
                    "sv"
                  ]
                },
                "additionalProperties": {
                  "type": "string"
                }
              },
              "checked": {
                "type": "boolean"
              },
              "needs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "source",
                    "price",
                    "phone"
                  ]
                }
              },
              "kind": {
                "type": "string",
                "const": "product"
              },
              "price": {
                "type": "number",
                "minimum": 0
              },
              "currency": {
                "type": "string",
                "pattern": "^[A-Z]{3}$"
              }
            },
            "required": [
              "id",
              "text",
              "checked",
              "kind",
              "currency"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "enum": [
                    "en",
                    "de",
                    "nl",
                    "sv"
                  ]
                },
                "additionalProperties": {
                  "type": "string"
                }
              },
              "checked": {
                "type": "boolean"
              },
              "needs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "source",
                    "price",
                    "phone"
                  ]
                }
              },
              "kind": {
                "type": "string",
                "const": "farm-card"
              },
              "phone": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "text",
              "checked",
              "kind"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "model": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "const": "multilingual-e5-small"
        },
        "dir": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "queryPrefix": {
          "type": "string",
          "const": "query: "
        },
        "dim": {
          "type": "number",
          "const": 384
        },
        "quantization": {
          "type": "string",
          "const": "int8"
        },
        "vocab": {
          "type": "string",
          "enum": [
            "full",
            "trimmed"
          ]
        },
        "sizeBytes": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "id",
        "dir",
        "source",
        "revision",
        "queryPrefix",
        "dim",
        "quantization",
        "vocab",
        "sizeBytes"
      ],
      "additionalProperties": false
    },
    "embeddings": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "dim": {
          "type": "number",
          "const": 384
        },
        "dtype": {
          "type": "string",
          "const": "float32"
        },
        "passagePrefix": {
          "type": "string",
          "const": "passage: "
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "momentId": {
                "type": "string",
                "minLength": 1
              },
              "lang": {
                "type": "string",
                "enum": [
                  "en",
                  "de",
                  "nl",
                  "sv"
                ]
              }
            },
            "required": [
              "momentId",
              "lang"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "file",
        "count",
        "dim",
        "dtype",
        "passagePrefix",
        "rows"
      ],
      "additionalProperties": false
    },
    "thresholds": {
      "type": "object",
      "properties": {
        "match": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "margin": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "match",
        "margin"
      ],
      "additionalProperties": false
    },
    "sizes": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      }
    },
    "checksums": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "labels": {
      "type": "object",
      "properties": {
        "standIn": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "standInVoice": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "person": {
                "type": "string",
                "minLength": 1
              },
              "files": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "person",
              "files"
            ],
            "additionalProperties": false
          }
        },
        "syntheticVoice": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "aiDubbed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "standIn",
        "standInVoice",
        "syntheticVoice",
        "aiDubbed"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "packId",
    "farmId",
    "farmSlug",
    "version",
    "mode",
    "createdAt",
    "noorLang",
    "visitorLangs",
    "clips",
    "moments",
    "addons",
    "model",
    "embeddings",
    "thresholds",
    "sizes",
    "checksums",
    "labels"
  ],
  "additionalProperties": false
}
